{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve prototype",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "squad_agentica.serve", "--no-browser"],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(Serving) (.*) at (.*)$",
                    "file": 2,
                    "location": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Serving",
                    "endsPattern": "^Serving"
                }
            }
        }
    ]
}
